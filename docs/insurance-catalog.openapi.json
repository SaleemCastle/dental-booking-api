        "tags": [
          "Insurance Catalog"
        ],
        "summary": "List insurers",
        "description": "Requires exact insurance_catalog.view. No role or wildcard bypass. Tenant is authenticated membership context. Catalog metadata only; no benefit rules or evidence linking. Conflicts include stale lock_version, invalid lifecycle or overlapping published date ranges.",
        "responses": {
          "200": {
            "description": "Standard ApiEnvelope with paginated data array of Insurer; Cache-Control private, no-store."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Standard error envelope, code CONFLICT; no state change."
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          }
        ]
      },
