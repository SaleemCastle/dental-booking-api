  "components": {
    "securitySchemes": {
      "sanctumBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "TenantHeader": {
        "name": "X-Tenant-Id",
        "in": "header",
        "required": false,
        "description": "Choose an active membership; this header never grants access.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "CatalogCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,49}$",
            "example": "TEST_CATALOG"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "pattern": "\\S",
            "example": "Catalog test metadata"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "CatalogUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version"
        ],
        "properties": {
