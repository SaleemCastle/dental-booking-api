{
  "openapi": "3.0.3",
  "info": {
    "title": "Dental Booking Insurance Catalog Foundation",
    "version": "1.0.0",
    "description": "P4-M1-A standalone additive API contract. Uses the existing Sanctum tenant/envelope conventions. Published versions immutable; independent editor/reviewer/publisher abilities. This contract does not implement or promise benefit rules, policies, claims or financial settlement. See docs/insurance-catalog.md for resources and lifecycle."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "sanctumBearer": []
    }
  ],
  "tags": [
    {
      "name": "Insurance Catalog"
    }
  ],
  "paths": {
