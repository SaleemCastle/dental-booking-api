        "description": "Requires exact insurance_catalog.manage. No role or wildcard bypass. Tenant is authenticated membership context. Catalog metadata only; no benefit rules or evidence linking. Conflicts include stale lock_version, invalid lifecycle or overlapping published date ranges.",
        "responses": {
          "201": {
            "description": "Created; standard ApiEnvelope with data.insurer."
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Standard error envelope, code CONFLICT; no state change."
