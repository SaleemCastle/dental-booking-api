{
  "openapi": "3.0.3",
  "info": {
    "title": "Insurance benefit rules and limits (P4-M2-B)",
    "version": "1.0.0",
    "description": "Additive manual recording contract. Synthetic examples only; no insurer rules are seeded. Limits and dates are reported facts, not calculated entitlements. See insurance-benefits.md."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
