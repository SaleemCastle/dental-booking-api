        "responses": {
          "200": {
            "description": "All history in data array, descending record ID, with meta.pagination. No current benefit resolver; follow supersedes_id for correction lineage. List order does not establish service-date applicability. Cache-Control: private, no-store. Monetary output uses two-decimal strings.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Benefit"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
