        "tags": [
          "Insurance benefits"
        ],
        "operationId": "planBenefits",
        "summary": "List benefit history",
        "description": "All history in data array, descending record ID, with meta.pagination. No current benefit resolver; follow supersedes_id for correction lineage. List order does not establish service-date applicability. Requires exact insurance_catalog.view. Same-tenant parent and same-patient association required. Sensitive access and changes are audited. Source is reported provenance, never insurer confirmation. Published/reviewed/withdrawn plan versions are immutable. No evidence activation or billing effects.",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "X-Tenant-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 15
            }
          }
