  "components": {
    "securitySchemes": {
      "sanctumBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PatientBenefitInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "scope",
          "coverage",
          "benefit_type",
          "observed_at",
          "provenance",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "patient_reported",
              "staff_observation"
            ],
            "example": "staff_observation"
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "category",
              "procedure"
            ],
            "example": "all"
          },
          "category": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "procedure_code": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "code_system": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "coverage": {
            "type": "string",
            "enum": [
              "covered",
              "excluded",
              "unknown",
              "unspecified"
            ],
            "example": "unknown"
          },
          "benefit_type": {
            "type": "string",
            "enum": [
              "percentage",
              "fixed",
              "unknown",
              "unspecified"
            ],
            "example": "unknown"
          },
          "percentage": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{1,3}(\\.\\d{1,2})?$",
            "description": "0 through 100 inclusive; only percentage benefits."
          },
          "currency": {
            "type": "string",
            "nullable": true,
            "pattern": "^[A-Z]{3}$"
          },
          "waiting_period_days": {
            "type": "integer",
            "nullable": true,
            "minimum": 0,
            "maximum": 2147483647
          },
          "prior_authorization_required": {
            "type": "boolean",
            "nullable": true,
            "description": "null means unspecified, not false."
          },
          "service_from": {
            "type": "string",
