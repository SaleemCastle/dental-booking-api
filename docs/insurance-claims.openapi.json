{
  "openapi": "3.0.3",
  "info": {
    "title": "Insurance Claims and Manual Response History",
    "version": "1.0.0",
    "description": "Staff-entered insurer observations only. No insurer integration, remittance, settlement, billing, or benefit consumption. Approval amounts are informational."
  },
  "servers": [{"url": "http://localhost:8000"}],
  "security": [{"sanctumBearer": []}],
  "paths": {
    "/api/patients/{patient}/insurance-claims/{claim}/responses": {
      "parameters": [{"$ref":"#/components/parameters/patient"},{"$ref":"#/components/parameters/claim"}],
      "get": {"summary":"List manual insurer response history","parameters":[{"$ref":"#/components/parameters/page"},{"$ref":"#/components/parameters/per_page"}],"responses":{"200":{"description":"Private response history and pagination in the standard API envelope"},"403":{"description":"Missing insurance_claims.responses.view"},"404":{"description":"Foreign tenant, patient, or claim"}}},
      "post": {"summary":"Record a manual insurer response","description":"Requires insurance_claims.responses.record. Additional information requests must include requested_information. Evidence ID must reference an already protected link for this exact submission.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ClaimResponseInput"}}}},"responses":{"201":{"description":"Staff-entered response observation"},"409":{"description":"Invalid claim status transition"},"422":{"description":"Invalid input or evidence association"}}}
    },
    "/api/patients/{patient}/insurance-claims/{claim}/appeals": {
      "parameters": [{"$ref":"#/components/parameters/patient"},{"$ref":"#/components/parameters/claim"}],
      "get": {"summary":"List appeal history","responses":{"200":{"description":"Appeals and immutable history"},"403":{"description":"Missing insurance_claims.appeals.view"}}},
      "post": {"summary":"Create an appeal draft","description":"Requires insurance_claims.appeals.manage. Only explicit coverage denial observations are eligible by default; administrative rejection is not presumed appealable.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["submission_id","decision_response_id","appeal_reason"],"properties":{"submission_id":{"type":"integer"},"decision_response_id":{"type":"integer"},"appeal_reason":{"type":"string","maxLength":8000}}}}}},"responses":{"201":{"description":"Appeal draft"},"422":{"description":"Decision is not eligible or does not reference this submission"}}}
    },
    "/api/patients/{patient}/insurance-claims/{claim}/appeals/{appeal}/submissions": {"post":{"summary":"Submit an appeal snapshot","parameters":[{"$ref":"#/components/parameters/patient"},{"$ref":"#/components/parameters/claim"},{"name":"appeal","in":"path","required":true,"schema":{"type":"integer"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["channel"],"properties":{"channel":{"type":"string","enum":["portal","email","fax","paper","other"]}}}}}},"responses":{"200":{"description":"Appeal with immutable submission snapshot"},"409":{"description":"Appeal is not a draft"}}}},
    "/api/patients/{patient}/insurance-claims/{claim}/appeals/{appeal}/responses": {"post":{"summary":"Record a manual appeal response","parameters":[{"$ref":"#/components/parameters/patient"},{"$ref":"#/components/parameters/claim"},{"name":"appeal","in":"path","required":true,"schema":{"type":"integer"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["appeal_submission_id","response_type","insurer_response_at","communication_channel","source_provenance"],"properties":{"appeal_submission_id":{"type":"integer"},"response_type":{"type":"string","enum":["acknowledged","under_review","approved","partially_approved","denied"]},"insurer_response_at":{"type":"string","format":"date-time"},"communication_channel":{"type":"string"},"source_provenance":{"type":"string"},"insurer_reference":{"type":"string"},"notes":{"type":"string"},"approved_amount":{"type":"string"},"currency":{"type":"string"}}}}}},"responses":{"201":{"description":"Staff-entered immutable response"},"409":{"description":"Invalid appeal transition"}}}},
    "/api/patients/{patient}/insurance-claims/{claim}/appeals/{appeal}/withdraw": {"post":{"summary":"Withdraw a draft or submitted appeal","parameters":[{"$ref":"#/components/parameters/patient"},{"$ref":"#/components/parameters/claim"},{"name":"appeal","in":"path","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Appeal with append-only withdrawal history"},"409":{"description":"Only a draft or submitted appeal can be withdrawn"}}}},
    "/api/patients/{patient}/insurance-claims/{claim}/corrections": {"post":{"summary":"Create corrected claim draft","description":"Requires insurance_claims.corrections.prepare and insurance_claims.prepare. Creates a new claim preserving predecessor and requires correction_reason.","parameters":[{"$ref":"#/components/parameters/patient"},{"$ref":"#/components/parameters/claim"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["correction_reason"],"properties":{"correction_reason":{"type":"string","maxLength":2000},"policy_revision_id":{"type":"integer","nullable":true},"estimate_id":{"type":"integer","nullable":true}}}}}},"responses":{"201":{"description":"New corrected claim in draft status"},"409":{"description":"A correction already exists"},"422":{"description":"Predecessor is not eligible"}}}}
  },
  "components": {
    "securitySchemes":{"sanctumBearer":{"type":"http","scheme":"bearer"}},
    "parameters":{"patient":{"name":"patient","in":"path","required":true,"schema":{"type":"integer"}},"claim":{"name":"claim","in":"path","required":true,"schema":{"type":"integer"}},"page":{"name":"page","in":"query","schema":{"type":"integer","minimum":1}},"per_page":{"name":"per_page","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}}},
    "schemas":{"ClaimResponseInput":{"type":"object","required":["submission_id","response_type","insurer_response_at","communication_channel","source_provenance"],"properties":{"submission_id":{"type":"integer"},"response_type":{"type":"string","enum":["acknowledged","under_review","additional_information_requested","rejected","approved","partially_approved","denied"]},"insurer_response_at":{"type":"string","format":"date-time"},"communication_channel":{"type":"string","enum":["phone","portal","email","fax","paper","other"]},"insurer_reference":{"type":"string","nullable":true},"source_provenance":{"type":"string"},"notes":{"type":"string","nullable":true},"requested_information":{"type":"string"},"response_deadline":{"type":"string","format":"date"},"evidence_id":{"type":"integer"},"approved_amount":{"type":"string","description":"Informational observation only; not a payment or settlement"},"currency":{"type":"string"}}}}
  }
}
